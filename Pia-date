<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Jubiläums-Einladung 💌</title>
<style>
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Helvetica Neue",Arial,sans-serif;
    background:
      linear-gradient(rgba(7,10,12,.40), rgba(10,10,12,.52)),
      url("data:image/jpeg;base64,") center center / cover no-repeat fixed;
    overflow:hidden;
    display:grid;
    place-items:center;
    color:#2b2a26;
  }

  .overlay{
    position:fixed; inset:0;
    background:
      radial-gradient(circle at 18% 15%, rgba(255,255,255,.09), transparent 25%),
      radial-gradient(circle at 80% 20%, rgba(255,240,230,.05), transparent 24%),
      radial-gradient(circle at 70% 80%, rgba(255,255,255,.04), transparent 22%);
    pointer-events:none;
  }

  .stage{
    width:min(92vw,430px);
    height:min(84vh,700px);
    position:relative;
    display:grid;
    place-items:center;
    z-index:2;
  }

  .hint{
    position:absolute;
    bottom:24px;
    color:rgba(255,255,255,.86);
    font-size:13px;
    letter-spacing:.03em;
    text-shadow:0 3px 14px rgba(0,0,0,.45);
    animation:pulse 1.8s ease-in-out infinite;
  }

  .envelope{
    width:310px;
    height:196px;
    position:relative;
    cursor:pointer;
    transform-style:preserve-3d;
    filter:drop-shadow(0 24px 38px rgba(0,0,0,.28));
    transition:transform .35s ease;
  }
  .envelope:hover{transform:translateY(-4px) rotate(-1deg)}

  .env-body{
    position:absolute; inset:0;
    background:linear-gradient(180deg,#7a7d61,#686d54);
    border-radius:18px;
    border:1px solid rgba(255,255,255,.14);
    overflow:hidden;
  }
  .env-body:before,
  .env-body:after{
    content:"";
    position:absolute;
    bottom:-42px;
    width:210px;height:210px;
    background:#84886a;
    transform:rotate(45deg);
  }
  .env-body:before{left:-104px}
  .env-body:after{right:-104px}

  .flap{
    position:absolute;
    left:0; right:0; top:0;
    margin:auto;
    width:0; height:0;
    border-left:155px solid transparent;
    border-right:155px solid transparent;
    border-top:114px solid #8b8f70;
    transform-origin:top center;
    transition:transform .9s cubic-bezier(.2,.75,.2,1);
    z-index:5;
  }

  .seal{
    position:absolute;
    left:50%; top:74px;
    transform:translateX(-50%);
    width:56px; height:56px;
    border-radius:50%;
    background:linear-gradient(145deg,#b7bd93,#8e946d);
    color:#fff;
    display:grid; place-items:center;
    font-size:24px;
    z-index:7;
    box-shadow:0 8px 18px rgba(56,61,38,.35);
    border:2px solid rgba(255,255,255,.6);
  }

  .letter-preview{
    position:absolute;
    left:18px; right:18px; bottom:12px;
    height:142px;
    border-radius:16px 16px 10px 10px;
    background:#f9f6ef;
    z-index:2;
    transition:transform .9s .18s cubic-bezier(.18,.8,.2,1), opacity .6s;
    box-shadow:0 10px 20px rgba(0,0,0,.08);
  }

  .envelope.open .flap{transform:rotateX(180deg)}
  .envelope.open .letter-preview{
    transform:translateY(-122px);
    opacity:.16;
  }

  .popup{
    position:fixed; inset:0;
    display:grid; place-items:center;
    padding:18px;
    background:rgba(11,12,12,.24);
    backdrop-filter:blur(10px);
    opacity:0;
    pointer-events:none;
    transition:.5s ease;
    z-index:20;
  }
  .popup.show{opacity:1; pointer-events:auto}

  .letter{
    width:min(92vw,395px);
    background:
      linear-gradient(rgba(249,246,239,.98), rgba(249,246,239,.98)),
      repeating-linear-gradient(0deg,transparent 0 31px,rgba(90,95,70,.05) 31px 32px);
    border-radius:28px;
    padding:34px 24px 24px;
    box-shadow:0 28px 84px rgba(0,0,0,.30);
    border:1px solid rgba(110,116,87,.18);
    text-align:center;
    transform:translateY(28px) scale(.95);
    opacity:0;
    transition:.6s cubic-bezier(.18,.8,.22,1);
  }
  .popup.show .letter{transform:none; opacity:1}

  .tiny{
    font-size:12px;
    color:#73785d;
    letter-spacing:.14em;
    text-transform:uppercase;
    margin-bottom:8px;
  }
  h1{
    margin:0;
    font-size:33px;
    line-height:1.06;
    font-weight:800;
    color:#3f4334;
  }
  .kiss{
    margin:10px 0 2px;
    font-size:28px;
    animation:kiss 1.8s ease-in-out infinite;
  }
  .main{
    margin:16px 0 16px;
    font-size:17px;
    line-height:1.5;
    color:#2b2a26;
  }
  .date{
    display:inline-block;
    padding:10px 16px;
    margin:0 auto 18px;
    border-radius:999px;
    background:#ece9dd;
    color:#596045;
    font-weight:800;
    font-size:15px;
    border:1px solid #d8d2bf;
  }
  .plan{
    display:flex;
    justify-content:center;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:18px;
  }
  .pill{
    background:#f3f0e7;
    border:1px solid #ddd8c6;
    border-radius:999px;
    padding:8px 11px;
    font-size:13px;
    font-weight:700;
    color:#525840;
  }
  .question{
    font-size:17px;
    font-weight:800;
    margin:10px 0 14px;
    color:#404531;
  }

  .yesno{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    position:relative;
    min-height:50px;
  }

  #yesBtn{
    background:linear-gradient(180deg,#7b805f,#676c53);
    color:white;
    box-shadow:0 10px 20px rgba(58,63,43,.24);
  }

  #noBtn{
    background:#e9e7de;
    color:#666b54;
    position:relative;
  }

  .error{
    display:none;
    margin-top:10px;
    padding:9px 11px;
    border-radius:12px;
    background:#f6f2e6;
    color:#686d54;
    font-size:13px;
    font-weight:700;
    animation:shake .35s;
  }

  .surprise{
    display:none;
    margin-top:16px;
    animation:pop .45s both;
  }

  .choices{
    display:grid;
    gap:10px;
  }
  button{
    border:0;
    border-radius:16px;
    padding:14px 14px;
    font-size:15px;
    font-weight:800;
    cursor:pointer;
    transition:.22s ease;
  }
  .choice{
    background:linear-gradient(180deg,#7b805f,#676c53);
    color:white;
    box-shadow:0 10px 20px rgba(58,63,43,.24);
  }
  .choice:hover{transform:translateY(-2px) scale(1.01)}

  .success{
    display:none;
    margin-top:18px;
    animation:pop .45s both;
  }
  .success strong{
    display:block;
    font-size:21px;
    margin-bottom:8px;
    color:#3f4334;
  }
  .calendar{
    width:100%;
    margin-top:12px;
    background:#1f1f22;
    color:white;
  }
  .micro{
    font-size:11px;
    color:#8b9077;
    margin-top:10px;
  }

  .heart{
    position:fixed;
    z-index:100;
    pointer-events:none;
    font-size:24px;
    animation:floatUp 1.9s ease-out forwards;
  }

  @keyframes pulse{
    0%,100%{opacity:.55}
    50%{opacity:1}
  }
  @keyframes kiss{
    0%,100%{transform:scale(1) rotate(0)}
    50%{transform:scale(1.10) rotate(-4deg)}
  }
  @keyframes shake{
    0%,100%{transform:translateX(0)}
    25%{transform:translateX(-5px)}
    50%{transform:translateX(5px)}
    75%{transform:translateX(-3px)}
  }
  @keyframes pop{
    from{opacity:0; transform:translateY(10px) scale(.97)}
    to{opacity:1; transform:none}
  }
  @keyframes floatUp{
    0%{opacity:1; transform:translateY(0) scale(.7) rotate(0)}
    100%{opacity:0; transform:translateY(-210px) scale(1.5) rotate(18deg)}
  }

  @media (max-width:380px){
    h1{font-size:29px}
    .letter{padding:28px 20px 22px}
    .envelope{width:280px;height:178px}
    .flap{border-left-width:140px;border-right-width:140px;border-top-width:103px}
  }

  .ruben-pop{
    position:fixed;
    width:150px;
    height:150px;
    border-radius:50%;
    object-fit:cover;
    z-index:999;
    pointer-events:none;
    border:4px solid rgba(255,255,255,.95);
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    opacity:0;
    animation:rubenBoom 3.6s cubic-bezier(.18,.85,.2,1) forwards;
  }

  .ruben-pop.big{
    width:190px;
    height:190px;
  }

  .yay-text{
    position:fixed;
    z-index:1000;
    left:50%;
    top:13%;
    transform:translate(-50%,-50%) scale(.6) rotate(-4deg);
    font-size:clamp(34px,9vw,72px);
    font-weight:1000;
    color:white;
    text-align:center;
    text-shadow:
      0 4px 0 #6b7052,
      0 9px 25px rgba(0,0,0,.45);
    pointer-events:none;
    opacity:0;
    animation:yayIn 2.4s ease-out forwards;
    white-space:nowrap;
  }

  @keyframes rubenBoom{
    0%{
      opacity:0;
      transform:translate(-50%,-50%) scale(.15) rotate(var(--r1));
    }
    18%{
      opacity:1;
      transform:translate(-50%,-50%) scale(1.18) rotate(var(--r2));
    }
    36%{
      transform:translate(-50%,-50%) scale(.96) rotate(var(--r3));
    }
    78%{
      opacity:1;
      transform:translate(-50%,-58%) scale(1) rotate(var(--r3));
    }
    100%{
      opacity:0;
      transform:translate(-50%,-115%) scale(.86) rotate(var(--r4));
    }
  }

  @keyframes yayIn{
    0%{opacity:0;transform:translate(-50%,-50%) scale(.25) rotate(-12deg)}
    18%{opacity:1;transform:translate(-50%,-50%) scale(1.18) rotate(4deg)}
    34%{transform:translate(-50%,-50%) scale(.98) rotate(-2deg)}
    78%{opacity:1}
    100%{opacity:0;transform:translate(-50%,-65%) scale(1.05) rotate(2deg)}
  }


  .ps-card{
    position:fixed;
    z-index:1100;
    left:50%;
    bottom:5vh;
    transform:translateX(-50%) translateY(30px) scale(.95);
    width:min(90vw,420px);
    background:rgba(249,246,239,.97);
    color:#3f4334;
    border:1px solid rgba(110,116,87,.22);
    border-radius:22px;
    padding:18px 20px;
    text-align:center;
    box-shadow:0 18px 60px rgba(0,0,0,.35);
    opacity:0;
    animation:psIn .6s ease forwards;
  }

  .ps-card strong{
    display:block;
    font-size:19px;
    margin-bottom:8px;
  }

  .ps-card .outfit{
    margin-top:10px;
    font-weight:800;
    line-height:1.5;
  }

  @keyframes psIn{
    to{
      opacity:1;
      transform:translateX(-50%) translateY(0) scale(1);
    }
  }

</style>
</head>
<body>
<div class="overlay"></div>

<div class="stage">
  <div class="envelope" id="envelope" onclick="openLetter()">
    <div class="env-body"></div>
    <div class="letter-preview"></div>
    <div class="flap"></div>
    <div class="seal">💌</div>
  </div>
  <div class="hint">Antippen zum Öffnen</div>
</div>

<div class="popup" id="popup">
  <div class="letter">
    <div class="tiny">Für mein Hase</div>
    <h1>Unser 1‑Jähriges. 💕</h1>
    <div class="kiss">😘</div>

    <div class="main">
      Ich will dich am <b>17. Oktober</b><br>
      zu unserem kleinen Jubiläums-Date entführen. 😏
    </div>

    <div class="date">17. Oktober 2026</div>

    <div class="plan">
      <div class="pill">🧺 Picknick</div>
      <div class="pill">🍝 Dinner 19:00</div>
      <div class="pill">🎬 Kino</div>
    </div>

    <div class="question" id="mainQuestion">Kommst du mit mir mit? 😌💕</div>

    <div class="yesno" id="yesno">
      <button id="yesBtn" onclick="yesClicked()">Ja 😘</button>
      <button id="noBtn" onclick="noClicked()">Nein 🙄</button>
    </div>

    <div class="error" id="error"></div>

    <div class="surprise" id="surprise">
      <div class="question">Kleine Überraschung für dich… 😏<br><span style="font-size:14px;font-weight:600;color:#777d63;">Wähl einfach 1 oder 2.</span></div>
      <div class="choices">
        <button class="choice" onclick="chooseOption(1)">1 ✨</button>
        <button class="choice" onclick="chooseOption(2)">2 💌</button>
      </div>
    </div>

    <div class="success" id="success">
      <strong id="successTitle">Auswahl gespeichert. 😏💕</strong>
      <div id="successText">Was dahinter steckt, bleibt noch geheim.</div>
      <button class="calendar" onclick="addToCalendar()">📅 In meinen Kalender</button>
      <div class="micro">Keine Hinweise. Kein Zurück. Überraschung bleibt Überraschung. 😌</div>
    </div>
  </div>
</div>

<script>
function openLetter(){
  const env = document.getElementById("envelope");
  env.classList.add("open");
  setTimeout(() => document.getElementById("popup").classList.add("show"), 700);
}

let noCount = 0;
const noMessages = [
  "Fehler 404: „Nein“ wurde leider nicht gefunden 😂",
  "Hmm… der Button scheint kaputt zu sein. Versuch's nochmal 😌",
  "Hase… das war eindeutig die falsche Auswahl 😏",
  "Nein ist für dieses Date technisch nicht vorgesehen 💕",
  "Der Nein-Button möchte jetzt bitte in Ruhe gelassen werden 😂",
  "Okay wow… sogar der Button gibt langsam auf."
];

function noClicked(){
  noCount++;

  const no = document.getElementById("noBtn");
  const yes = document.getElementById("yesBtn");
  const err = document.getElementById("error");

  err.textContent = noMessages[(noCount - 1) % noMessages.length];
  err.style.display = "block";
  err.style.animation = "none";
  void err.offsetWidth;
  err.style.animation = "shake .35s";

  const x = (Math.random() * 100) - 50;
  const y = (Math.random() * 50) - 25;
  no.style.transform = `translate(${x}px,${y}px) scale(${Math.max(.55, 1 - noCount * .08)}) rotate(${x/12}deg)`;
  yes.style.transform = `scale(${Math.min(1.24, 1 + noCount * .045)})`;

  if(noCount >= 5) no.textContent = "Immer noch nein? 😂";
  if(noCount >= 7) no.textContent = "Aufgeben 😭";
}

function yesClicked(){
  document.getElementById("yesno").style.display = "none";
  document.getElementById("error").style.display = "none";
  document.getElementById("mainQuestion").textContent = "Perfekt. 😏💕";
  document.getElementById("surprise").style.display = "block";
  burst();
}

function chooseOption(option){
  document.getElementById("surprise").style.display = "none";
  document.getElementById("success").style.display = "block";

  const title = document.getElementById("successTitle");
  const text = document.getElementById("successText");

  title.textContent = "Auswahl gespeichert. 😏💕";
  if(option === 1){
    text.textContent = "Was hinter der 1 steckt, erfährst du erst am 17. Oktober. ✨";
  } else {
    text.textContent = "Was hinter der 2 steckt, bleibt bis zum 17. Oktober mein Geheimnis. 💌";
  }

  burst();
  setTimeout(happyRubenFinale, 450);
}


const rubenPhotos = [
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/jpeg;base64,',
  'data:image/png;base64,',
  'data:image/jpeg;base64,'
];


function playFartSound(){
  try{
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    const ctx = new AudioCtx();

    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    const filter = ctx.createBiquadFilter();

    osc.type = "sawtooth";
    osc.frequency.setValueAtTime(95, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(42, ctx.currentTime + 0.28);

    filter.type = "lowpass";
    filter.frequency.setValueAtTime(260, ctx.currentTime);

    gain.gain.setValueAtTime(0.0001, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.22, ctx.currentTime + 0.025);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.34);

    osc.connect(filter);
    filter.connect(gain);
    gain.connect(ctx.destination);

    osc.start();
    osc.stop(ctx.currentTime + 0.36);
    setTimeout(()=>ctx.close(), 600);
  }catch(e){}
}

function showPS(){
  const old = document.querySelector(".ps-card");
  if(old) old.remove();

  const ps = document.createElement("div");
  ps.className = "ps-card";
  ps.innerHTML = `
    <strong>P.S. 😌</strong>
    Du stinkst. 💨😂
    <div class="outfit">
      Bitte das rote Top + die blaue Jeans anziehen ❤️👖<br>
      und den Essentials-Hoodie mitnehmen, falls es kalt wird 🫶
    </div>
  `;
  document.body.appendChild(ps);
}

function happyRubenFinale(){
  const yay = document.createElement("div");
  yay.className = "yay-text";
  yay.textContent = "YAAAAAY 😭💕";
  document.body.appendChild(yay);
  setTimeout(() => yay.remove(), 2600);

  const total = 52;
  for(let i=0; i<total; i++){
    setTimeout(() => {
      const img = document.createElement("img");
      img.className = "ruben-pop" + (Math.random() > .72 ? " big" : "");
      img.src = rubenPhotos[Math.floor(Math.random()*rubenPhotos.length)];

      // Keep most faces away from the very center so the confirmation remains visible.
      let x = 7 + Math.random()*86;
      let y = 17 + Math.random()*72;
      if(x > 33 && x < 67 && y > 30 && y < 72){
        x = Math.random() > .5 ? 12 + Math.random()*18 : 70 + Math.random()*18;
      }

      img.style.left = x + "vw";
      img.style.top = y + "vh";
      img.style.setProperty("--r1", ((Math.random()*80)-40) + "deg");
      img.style.setProperty("--r2", ((Math.random()*36)-18) + "deg");
      img.style.setProperty("--r3", ((Math.random()*24)-12) + "deg");
      img.style.setProperty("--r4", ((Math.random()*70)-35) + "deg");
      img.style.animationDelay = (Math.random()*.16) + "s";

      document.body.appendChild(img);
      playFartSound();
      setTimeout(() => img.remove(), 4200);
    }, i * 65);
  }
  setTimeout(showPS, 3600);
}

function burst(){
  const emojis = ["💕","💖","😘","✨","❤️","💘"];
  for(let i=0;i<26;i++){
    const h = document.createElement("div");
    h.className = "heart";
    h.textContent = emojis[Math.floor(Math.random()*emojis.length)];
    h.style.left = (12 + Math.random()*76) + "vw";
    h.style.top = (58 + Math.random()*20) + "vh";
    document.body.appendChild(h);
    setTimeout(() => h.remove(), 2000);
  }
}

function addToCalendar(){
  const ics=`BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Ruben & Pia Anniversary//DE
CALSCALE:GREGORIAN
BEGIN:VEVENT
UID:ruben-pia-anniversary-20261017
DTSTAMP:20260922T113600Z
DTSTART:20261017T150000
DTEND:20261017T223000
SUMMARY:💕 Jubiläums-Date mit Ruben
LOCATION:Überraschung ✨
DESCRIPTION:🧺 Picknick\n🍝 Dinner um 19:00 Uhr\n🎬 Danach Kino\n\nFür unser 1-Jähriges 💕
BEGIN:VALARM
TRIGGER:-PT2H
ACTION:DISPLAY
DESCRIPTION:In 2 Stunden beginnt euer Jubiläums-Date 💕
END:VALARM
END:VEVENT
END:VCALENDAR`;

  const blob = new Blob([ics], {type:"text/calendar;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "Jubilaeums-Date-Pia-Ruben-17-Oktober-2026.ics";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
</script>
</body>
</html>
